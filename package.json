{
  "name": "baymax",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "dev": "bun --watch index.ts",
    "build": "bun build ./index.ts --outdir ./dist --target bun",
    "start": "bun ./dist/index.js",
    "lint": "bun oxlint .",
    "lint:fix": "bun oxlint --fix .",
    "fmt": "bun oxfmt --check .",
    "fmt:write": "bun oxfmt --write ."
  },
  "dependencies": {
    "@discordx/importer": "^1.3.3",
    "discord.js": "^14.27.0",
    "discordx": "^11.13.3",
    "js-yaml": "^5.2.2",
    "tslog": "^5.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
