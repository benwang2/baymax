# Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Discord Application (Client) ID
DISCORD_CLIENT_ID=your_application_id_here

# Comma-separated list of guild IDs for registering slash commands
# during development (speeds up command sync vs global registration).
# Leave empty or unset for global (production) registration.
# Example: DISCORD_TEST_GUILDS=12345,55789,590123
DISCORD_TEST_GUILDS=

# Optional: Grok wake relay. When set, messages that mention hayagrov or reply
# to one of its messages are POSTed ({channel_id, message_id, source:"baymax"})
# to this webhook. Leave unset to disable.
GROK_WAKE_WEBHOOK_URL=
# Optional full Authorization header value sent with each wake, e.g. "Bearer <key>".
GROK_WAKE_WEBHOOK_AUTH=
# Optional comma-separated channel ID allowlist (empty = all channels).
GROK_WAKE_CHANNELS=
# Optional override of the user ID that triggers wakes (default: hayagrov).
GROK_WAKE_TARGET_USER_ID=
