# Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Discord Application (Client) ID
DISCORD_CLIENT_ID=your_application_id_here

# Comma-separated list of guild IDs for registering slash commands
# during development (speeds up command sync vs global registration).
# Leave empty or unset for global (production) registration.
# Example: DISCORD_TEST_GUILDS=12345,55789,590123
DISCORD_TEST_GUILDS=
